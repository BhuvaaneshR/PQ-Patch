# Copy to .env and fill in. Never commit .env.
#
# Switching provider is an API key, a base URL, and a model name. The provider
# must be OpenAI-compatible: client.py calls client.chat.completions.create(...).
# No OpenAI-compatible endpoint? See section 5.2 of the Capstone Guide.

LLM_API_KEY=your-key-here
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=the-model-name

# Example: Groq's free tier (all three lines must be changed, not just the key).
# The model id includes the "openai/" prefix. Free tiers rate-limit per minute, so
# also let retries wait longer than the 5 s default:
#
# LLM_API_KEY=<your Groq key>
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MAX_RETRY_DELAY=60

# Token limits (all optional, all off unless set). Free tiers limit tokens per minute AND per
# day, per model. The day limit cannot be waited out, so give the app somewhere else to go:
#
# LLM_FALLBACK_MODELS=<other-model-id>,<another-model-id>   # tried in order when the main model is out of quota
#                           (use ids your provider lists; on Groq each model has its own daily quota)
# LLM_TPM_LIMIT=8000        # pace calls so the per-minute limit is never hit
# LLM_CACHE=1               # store validated replies in .llm_cache/ so repeating a step costs no tokens
# LLM_CACHE_DIR=.llm_cache

# To run against the local deterministic stub instead:
#
# LLM_API_KEY=not-needed
# LLM_BASE_URL=local://stub
# LLM_MODEL=stub:ok
#
# Modes: ok fenced preamble malformed badshape empty refused error flaky
#        ratelimit obedient toolcall traversal neverstop badargs
